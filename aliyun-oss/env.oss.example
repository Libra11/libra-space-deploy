NEXT_PUBLIC_API_BASE_URL="https://space.penlibra.xin"
NEXT_PUBLIC_PADDLE_ENV="sandbox"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="<paddle-client-side-token>"
NEXT_PUBLIC_LEGAL_ENTITY_NAME="<个体工商户营业执照上的完整名称>"
NEXT_PUBLIC_LEGAL_ENTITY_ADDRESS="<经营者登记地址>"
NEXT_PUBLIC_LEGAL_SUPPORT_EMAIL="support@knora.one"

OSS_BUCKET="<globally-unique-oss-bucket-name>"
OSS_REGION="cn-beijing"
OSS_ENDPOINT="oss-cn-beijing.aliyuncs.com"

# 留空表示部署到 Bucket 根目录。根目录同步会删除 Bucket 根下多余对象，
# 必须同时设置 ALLOW_OSS_ROOT_DEPLOY=true 才允许执行。
OSS_PREFIX=""
ALLOW_OSS_ROOT_DEPLOY="false"

# 默认同步前执行 npm ci，保证本地发布可复现。
SKIP_INSTALL="false"
APPLY_WEBSITE_CONFIG="true"
