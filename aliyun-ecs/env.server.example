PORT=3000
DATABASE_URL="postgresql://<rds_user>:<rds_password>@<rds_internal_endpoint>:5432/<database>?schema=public"
REDIS_URL="redis://:<redis_password>@<tair_internal_endpoint>:6379"
JWT_ACCESS_SECRET="<replace-with-strong-secret>"
JWT_REFRESH_SECRET="<replace-with-strong-secret>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
ADMIN_EMAIL="admin@example.com"
CORS_ORIGINS="https://space.penlibra.xin"
SWAGGER_ENABLED="false"
TRUST_PROXY="1"
HTTP_BODY_LIMIT="1mb"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS="<smtp-password>"
SMTP_FROM="Libra Space <noreply@example.com>"
AUTH_REGISTER_VERIFICATION_EXPIRES_MINUTES="10"
AUTH_REGISTER_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
SYNC_CHANGE_LOG_RETENTION_DAYS="30"
SYNC_CHANGE_LOG_MAX_ROWS_PER_WORKSPACE="5000"
SYNC_TOMBSTONE_RETENTION_DAYS="90"
BILLING_WECHAT_PAY_NATIVE_MODE="live"
BILLING_WECHAT_WEBHOOK_MODE="live"
BILLING_WECHAT_PAY_APP_ID="<wechat-pay-bound-app-id>"
BILLING_WECHAT_PAY_MCH_ID="<wechat-pay-merchant-id>"
BILLING_WECHAT_PAY_MERCHANT_SERIAL_NO="<wechat-pay-merchant-api-cert-serial-no>"
BILLING_WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH="/app/certs/wechat/apiclient_key.pem"
BILLING_WECHAT_PAY_PUBLIC_KEY_ID="<wechat-pay-public-key-id>"
BILLING_WECHAT_PAY_PUBLIC_KEY_PEM="<wechat-pay-public-key-pem>"
BILLING_WECHAT_PAY_API_V3_KEY="<32-byte-api-v3-key>"
BILLING_WECHAT_PAY_NOTIFY_URL="https://space.penlibra.xin/api/billing/webhooks/wechat"
BILLING_ALIPAY_WEBHOOK_MODE="live"
BILLING_APPLE_VERIFY_MODE="live"
BILLING_GOOGLE_VERIFY_MODE="live"
BILLING_ALIPAY_PUBLIC_KEY_PEM="<alipay-public-key-pem>"
BILLING_APPLE_SHARED_SECRET="<apple-shared-secret>"
BILLING_GOOGLE_PACKAGE_NAME="<android-package-name>"
BILLING_GOOGLE_SERVICE_ACCOUNT_EMAIL="<google-service-account-email>"
BILLING_GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="<google-service-account-private-key>"
