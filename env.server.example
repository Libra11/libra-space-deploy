PORT=3000
DATABASE_URL="postgresql://<rds_user>:<rds_password>@<rds_internal_endpoint>:5432/<database>?schema=public"
REDIS_URL="redis://:<redis_password>@<tair_internal_endpoint>:6379"
JWT_ACCESS_SECRET="<replace-with-strong-secret>"
JWT_REFRESH_SECRET="<replace-with-strong-secret>"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
ADMIN_EMAIL="admin@example.com"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS="<smtp-password>"
SMTP_FROM="Libra Space <noreply@example.com>"
AUTH_REGISTER_VERIFICATION_EXPIRES_MINUTES="10"
AUTH_REGISTER_VERIFICATION_RESEND_COOLDOWN_SECONDS="60"
SYNC_CHANGE_LOG_RETENTION_DAYS="30"
SYNC_CHANGE_LOG_MAX_ROWS_PER_WORKSPACE="5000"
SYNC_TOMBSTONE_RETENTION_DAYS="90"
